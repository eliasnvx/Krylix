{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "A kill feed, health plates over whatever you aim at, per-player mob stats and an all-time PvP leaderboard, with a public API for addons.",
  "authors": ["eliasnvx"],
  "contact": {
    "homepage": "https://modrinth.com/mod/krylix",
    "sources": "https://github.com/eliasnvx/Krylix",
    "issues": "https://github.com/eliasnvx/Krylix/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.eliasnvx.krylix.fabric.KrylixFabric"],
    "client": ["com.eliasnvx.krylix.fabric.client.KrylixFabricClient"],
    "modmenu": ["com.eliasnvx.krylix.fabric.client.KrylixModMenu"]
  },
  "mixins": ["krylix.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}",
    "cloth-config": ">=${cloth_config_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
