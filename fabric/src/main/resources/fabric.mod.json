{
  "schemaVersion": 1,
  "id": "krylix",
  "version": "${version}",
  "name": "Krylix",
  "description": "Next-generation kill feed for Minecraft inspired by CS:GO and Valorant",
  "authors": [
    "eliasnvx"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/krylix",
    "sources": "https://github.com/eliasnvx/Krylix",
    "issues": "https://github.com/eliasnvx/Krylix/issues"
  },
  "license": "MIT",
  "icon": "assets/krylix/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "io.eliasnvx.krylix.fabric.KrylixFabric"
      }
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-language-kotlin": ">=1.10.0",
    "minecraft": "~1.20.1",
    "java": ">=17"
  },
  "suggests": {
    "fabric-api": ">=0.92.0"
  }
}
